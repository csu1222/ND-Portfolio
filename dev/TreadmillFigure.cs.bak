// =============================================================================
// TreadmillFigure — 트레드밀 인물 자리표시(사람 실루엣) 생성기
// =============================================================================
// [담당] Core Gameplay (윤호영)  ※ 트레드밀 시스템
//
// [왜] 모델 프리팹이 아직 없는 자리(산적·용병 호위)를 큐브 하나로 때우면 앞뒤도 실루엣도
//      없어서 '무엇인지' 읽히지 않는다. 몸통·머리·어깨·팔·다리를 프리미티브로 세워
//      최소한 사람으로 보이게 한다. 진짜 프리팹이 들어오면 이 생성기는 안 쓰인다.
//
// [무엇] Build()는 목표 키(m)에 맞춰 자동 스케일하고 발바닥을 로컬 y=0에 맞춰 돌려준다.
//        콜라이더는 전부 제거한다(트레드밀은 물리 없음, 시각 전용).
//
// [주의] 자리표시 전용이다. 여기에 게임 로직을 붙이지 말 것.
// =============================================================================

using UnityEngine;

/// <summary>프리미티브로 사람 실루엣을 세우는 자리표시 생성기(시각 전용).</summary>
public static class TreadmillFigure
{
    /// <summary>사람 실루엣 하나를 만들어 parent 아래에 붙인다. 발바닥이 로컬 y=0에 온다.</summary>
    /// <param name="targetHeight">머리끝까지의 목표 키(m).</param>
    /// <param name="armed">true면 등에 멘 무기 하나를 더 붙인다(산적·호위 구분용).</param>
    public static GameObject Build(Transform parent, string name, Color cloth, Color skin,
                                   float targetHeight, bool armed)
    {
        // 루트는 비워 둔다 — 바깥(전투 연출·스테이지)이 매 프레임 위치를 잡기 때문이다.
        // 흔들림과 발밑 보정은 전부 자식 Body에서 처리해 서로 싸우지 않게 한다.
        var root = new GameObject(name);
        root.transform.SetParent(parent, false);
        var body = new GameObject(BodyName);
        body.transform.SetParent(root.transform, false);

        // 아래 수치는 키 약 1.7m 사람 기준. 마지막에 targetHeight로 통째로 스케일한다.
        Part(body, PrimitiveType.Cube,    new Vector3(-0.13f, 0.38f, 0f), new Vector3(0.17f, 0.76f, 0.19f), cloth * 0.78f); // 다리
        Part(body, PrimitiveType.Cube,    new Vector3( 0.13f, 0.38f, 0f), new Vector3(0.17f, 0.76f, 0.19f), cloth * 0.78f);
        Part(body, PrimitiveType.Capsule, new Vector3( 0f,    1.06f, 0f), new Vector3(0.44f, 0.36f, 0.30f), cloth);          // 몸통
        Part(body, PrimitiveType.Cube,    new Vector3( 0f,    1.37f, 0f), new Vector3(0.64f, 0.15f, 0.27f), cloth * 0.88f); // 어깨
        Part(body, PrimitiveType.Cube,    new Vector3(-0.29f, 1.06f, 0f), new Vector3(0.13f, 0.56f, 0.15f), cloth * 0.84f); // 팔
        Part(body, PrimitiveType.Cube,    new Vector3( 0.29f, 1.06f, 0f), new Vector3(0.13f, 0.56f, 0.15f), cloth * 0.84f);
        Part(body, PrimitiveType.Sphere,  new Vector3( 0f,    1.58f, 0f), new Vector3(0.25f, 0.28f, 0.25f), skin);           // 머리

        if (armed)
        {
            // 등에 비스듬히 멘 막대(창·몽둥이). 실루엣에 방향성을 준다.
            var w = Part(body, PrimitiveType.Cube, new Vector3(0.30f, 1.16f, -0.14f),
                         new Vector3(0.07f, 1.05f, 0.07f), new Color(0.24f, 0.19f, 0.14f));
            w.transform.localRotation = Quaternion.Euler(14f, 0f, -24f);
        }

        FitHeightAndGround(body.transform, targetHeight);
        return root;
    }

    /// <summary>걷는 느낌만 내는 아주 가벼운 상하 흔들림을 붙인다(위상을 달리해 여럿이 어긋나게).</summary>
    public static void AddBob(GameObject figure, float phase)
    {
        if (figure == null) return;
        // 루트가 아니라 Body에 붙인다 — 루트는 바깥이 위치를 잡는 자리다.
        Transform target = figure.transform.Find(BodyName);
        var host = (target != null ? target.gameObject : figure);
        var bob = host.GetComponent<TreadmillFigureBob>();
        if (bob == null) bob = host.AddComponent<TreadmillFigureBob>();
        bob.phase = phase;
    }

    private const string BodyName = "Body";

    // ── 내부 ──

    private static GameObject Part(GameObject root, PrimitiveType type, Vector3 pos, Vector3 scale, Color color)
    {
        var go = GameObject.CreatePrimitive(type);
        var col = go.GetComponent<Collider>();
        if (col != null) Object.DestroyImmediate(col);          // 트레드밀은 물리 없음
        go.transform.SetParent(root.transform, false);
        go.transform.localPosition = pos;
        go.transform.localScale = scale;

        var mr = go.GetComponent<Renderer>();
        if (mr != null)
        {
            var sh = Shader.Find("Universal Render Pipeline/Lit");
            if (sh == null) sh = Shader.Find("Standard");
            var m = new Material(sh) { color = color };
            mr.sharedMaterial = m;
            mr.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.On;
        }
        return go;
    }

    // 전체 바운즈를 재서 목표 키에 맞추고, 발바닥을 로컬 y=0으로 내린다.
    private static void FitHeightAndGround(Transform root, float targetHeight)
    {
        var rends = root.GetComponentsInChildren<Renderer>();
        if (rends.Length == 0) return;

        Bounds b = rends[0].bounds;
        for (int i = 1; i < rends.Length; i++) b.Encapsulate(rends[i].bounds);
        if (b.size.y > 0.001f && targetHeight > 0.01f)
            root.localScale *= targetHeight / b.size.y;

        // 스케일 후 다시 재서 발밑을 맞춘다(스케일이 바운즈를 바꾸므로 두 번 잰다).
        rends = root.GetComponentsInChildren<Renderer>();
        b = rends[0].bounds;
        for (int i = 1; i < rends.Length; i++) b.Encapsulate(rends[i].bounds);
        Transform p = root.parent != null ? root.parent : root;
        float footLocalY = p.InverseTransformPoint(new Vector3(b.center.x, b.min.y, b.center.z)).y;
        var lp = root.localPosition;
        lp.y -= footLocalY;                                   // 발바닥을 부모 로컬 y=0으로
        root.localPosition = lp;
    }
}

/// <summary>자리표시 인물의 걷기 흔들림(상하 + 좌우 기울기). 시각 전용, 아주 가볍다.</summary>
[DisallowMultipleComponent]
public class TreadmillFigureBob : MonoBehaviour
{
    [Tooltip("상하 흔들림 폭(m). 인물 키 기준 로컬 단위가 아니라 부모 로컬 단위다.")]
    public float amplitude = 0.045f;
    [Tooltip("흔들림 속도(rad/s).")]
    public float speed = 6.5f;
    [Tooltip("좌우로 기우는 각도(도).")]
    public float swayDegrees = 2.5f;
    [Tooltip("여럿이 똑같이 흔들리지 않게 하는 위상차.")]
    public float phase;
    [Tooltip("false면 제자리에 선다(정박·정지 중).")]
    public bool moving = true;

    private Vector3 basePos;
    private Quaternion baseRot;
    private bool captured;

    private void OnEnable()
    {
        if (captured) return;
        basePos = transform.localPosition;
        baseRot = transform.localRotation;
        captured = true;
    }

    private void Update()
    {
        if (!captured) return;
        if (!moving)
        {
            transform.localPosition = basePos;
            transform.localRotation = baseRot;
            return;
        }
        float t = Time.time * speed + phase;
        transform.localPosition = basePos + new Vector3(0f, Mathf.Abs(Mathf.Sin(t)) * amplitude, 0f);
        transform.localRotation = baseRot * Quaternion.Euler(0f, 0f, Mathf.Sin(t * 0.5f) * swayDegrees);
    }
}
